{
  "expo": {
    "name": "UniFit",
    "slug": "unifit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/unifit-logo.png",
    "scheme": "unifit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/unifit-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unifit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "UniFit uses the camera to detect exercise posture and count repetitions."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/unifit-logo.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.unifit.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/unifit-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "UniFit uses the camera to count repetitions and measure your movement range."
        }
      ],
      [
        "expo-vision-camera-v4-mediapipe/plugin",
        {
          "numHands": 1,
          "minDetectionConfidence": 0.5,
          "minPresenceConfidence": 0.5,
          "minTrackingConfidence": 0.5,
          "enablePose": true,
          "enableFace": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
