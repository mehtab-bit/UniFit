{
  "expo": {
    "name": "UniFit",
    "slug": "unifit",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unifit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/unifit-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unifit.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "UniFit uses the camera to count repetitions and measure your movement range."
      }
    },
    "android": {
      "versionCode": 2,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.unifit.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "UniFit uses the camera to count repetitions and measure your movement range."
        }
      ],
      "./plugins/withPoseLandmarker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b45b0243-bf99-41a1-8819-dde526f5fc6a"
      }
    },
    "owner": "mehtab-bit"
  }
}
