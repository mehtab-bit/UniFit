# ==============================================================================
# UniFit Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your project values.
# NEVER commit the real '.env' or any real service role keys / secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Public / Client-Safe)
# ------------------------------------------------------------------------------
# These variables begin with 'EXPO_PUBLIC_' and are embedded into the client
# JavaScript bundle by Expo. Do NOT place sensitive secrets here.

# Supabase Project URL (Dashboard > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (Client-safe with Row Level Security)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# FastAPI Backend API Base URL
# - For iOS Simulator / Web: http://localhost:8000
# - For Android Emulator:    http://10.0.2.2:8000
# - For Physical Devices:    http://<YOUR_PC_LAN_IP>:8000 (e.g. http://192.168.1.15:8000)
#   (Note: 'localhost' on a physical phone points to the phone itself, not your PC)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Demo Mode Toggle (enables "Continue with Demo Account" button for presentations)
EXPO_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Private / Server-Side ONLY)
# ------------------------------------------------------------------------------
# These variables are read exclusively by the Python FastAPI backend process.
# They bypass Row Level Security and MUST NEVER be exposed to the mobile client.

# Supabase Service Role Secret Key (Dashboard > Project Settings > API > service_role)
# CRITICAL SECURITY: Keep this key private. Never prefix with EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Supabase JWT Secret (Dashboard > Project Settings > API > JWT Secret)
# Used by the FastAPI backend to verify Supabase access tokens locally.
# CRITICAL SECURITY: Keep this key private. Never prefix with EXPO_PUBLIC_.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Authentication mode for the FastAPI backend:
#   live - require and verify a Supabase bearer token on every user route
#   dev  - offline/engine-testing only; no token required
# Defaults to live whenever Supabase credentials are configured.
UNIFIT_AUTH_MODE=live

# Optional remote token verification fallback (used only when SUPABASE_JWT_SECRET
# is absent). Off by default because it adds a network round-trip per request.
SUPABASE_AUTH_REMOTE_FALLBACK=false

